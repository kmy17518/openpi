# Run definition for the pi0.5 single-task BEHAVIOR-1K training "single-task-turning-on-radio-bs512".
# Shell syntax (KEY=VALUE, no spaces around '='); sourced by scripts/b1k/train_b1k_run.sh and parsed by
# scripts/b1k/hf_checkpoint_uploader.py and scripts/b1k/hf_latest_full_checkpoint_uploader.py. The uploaders
# re-read this file every cycle, so HF_REPO / HF_EXP_FOLDER and the upload schedule can be changed while they run;
# the training flags only take effect on a (re)launch. See docs/b1k_runs.md.
#
# Machine-specific values (adapt when replicating elsewhere): DATASET_ROOT, OPENPI_DIR, VENV, JAX_CACHE,
# STAGING_DIR, CUDA_VISIBLE_DEVICES. Everything else defines the experiment itself.

# --- identity -------------------------------------------------------------------------------------------
EXP_NAME=single-task-turning-on-radio-bs512
CONFIG_NAME=pi05_b1k
WANDB_PROJECT=b1k-challenge-2026-pi
# Public Hugging Face *project* repo (same convention as kmy17518/b1k-challenge-2026-gr00t): one folder per
# experiment. This run lives in <HF_REPO>/<HF_EXP_FOLDER>/: checkpoint-<step>/ (eval-only copies), resume/
# (the newest full checkpoint), README.md. The HF_TOKEN in the environment must have write access to the repo.
HF_REPO=kmy17518/b1k-challenge-2026-pi
HF_EXP_FOLDER=single-task-turning-on-radio-bs512

# --- data -----------------------------------------------------------------------------------------------
TASK_NAMES=turning_on_radio
DATASET_ROOT=/tmp/dev/datasets/2026-challenge-demos
REPO_ID=behavior-1k/2026-challenge-demos

# --- training hyper-parameters (see docs/b1k.md, "Gradient accumulation, a lighter remat policy and FSDP
# (measured)": the fastest measured 4-GPU configuration for global batch 512) -------------------------------
BATCH_SIZE=512
GRAD_ACCUM_STEPS=2            # 2 micro-batches of 256 = 64 samples per GPU per micro-batch
FSDP_DEVICES=4
REMAT_POLICY=dots_with_no_batch_dims_saveable
MAX_TOKEN_LEN=144             # task_name prompts + state need <= 142 tokens; serving can keep the default 200
NUM_WORKERS=16
NUM_TRAIN_STEPS=100000
SAVE_INTERVAL=2500
MAX_TO_KEEP=3                 # save total limit: full (resumable) checkpoints kept on disk
CUDA_VISIBLE_DEVICES=0,1,2,3

# --- software -------------------------------------------------------------------------------------------
OPENPI_DIR=/tmp/dev/baselines/openpi
VENV=/tmp/dev/baselines/venv-openpi-jax010   # jax 0.10.2 + CUDA 13 venv, built by scripts/b1k/setup_jax_cuda13_venv.sh
JAX_CACHE=/tmp/.cache/jax-010                # its own JAX compile cache (the pinned .venv uses /tmp/.cache/jax)

# --- checkpoint upload schedule (hf_checkpoint_uploader.py) -----------------------------------------------
# Steps <= UPLOAD_SWITCH_STEP are uploaded when divisible by UPLOAD_EVERY_UNTIL, later steps when divisible by
# UPLOAD_EVERY_AFTER; the final checkpoint (step NUM_TRAIN_STEPS-1, which the trainer always saves) is uploaded too.
UPLOAD_EVERY_UNTIL=10000
UPLOAD_SWITCH_STEP=50000
UPLOAD_EVERY_AFTER=5000
UPLOAD_FINAL=1
STAGING_DIR=/tmp/dev/hf-staging/single-task-turning-on-radio-bs512
UPLOADER_POLL_SECONDS=60

# --- latest FULL checkpoint mirror (hf_latest_full_checkpoint_uploader.py) --------------------------------
# <HF_REPO>/<HF_EXP_FOLDER>/<HF_RESUME_FOLDER>/checkpoint-<step>/ always holds exactly one complete, resumable
# checkpoint (params + train_state + assets, ~42 GB): the newest one on disk. Older steps are deleted from the repo
# AND every LFS object that nothing in the repo tree references any more is permanently purged with history
# rewrite, so no orphaned blobs count against the storage quota (objects shared with the eval-only copies stay).
HF_RESUME_FOLDER=resume
HF_FULL_REPO_PRIVATE=0        # only used when the mirror has to create the repo: 1 = private, 0 = public
FULL_UPLOADER_POLL_SECONDS=120
